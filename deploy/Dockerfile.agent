FROM docker.io/library/python:3.12-slim
RUN useradd -m -u 1000 agent && mkdir -p /workspaces && chown agent:agent /workspaces
WORKDIR /app
COPY agent.py agent_v5.py harness_profiles.py judge.py /app/
COPY deploy/agent_server.py /app/deploy/
ENV WORKSPACE_ROOT=/workspaces PORT=8094 PYTHONUNBUFFERED=1
EXPOSE 8094
USER agent
CMD ["python3", "/app/deploy/agent_server.py"]
