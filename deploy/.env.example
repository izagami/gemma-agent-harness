# OpenAI-compatible chat endpoint of your model server (llama.cpp llama-server, vLLM, Ollama /v1, LM Studio ...)
# The model must support tool calling (llama-server: start it with --jinja).
AGENT_API=http://host.docker.internal:8080/v1/chat/completions
AGENT_MODEL=local
AGENT_API_KEY=none
# Harness profile (v6f = best tested). See harness_profiles.py / agent_v5.py FEATURES.
AGENT_PROFILE=v6f
# Clients (Open WebUI) must send this key. Leave empty only on a trusted single-user machine.
SERVER_API_KEY=change-me
