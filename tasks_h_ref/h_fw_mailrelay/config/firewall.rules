# mx-relay02 firewall (203.0.113.25 / 2001:db8:100::25) - audited 2026-10

ipset internal4 10.40.0.0/16
ipset internal6 2001:db8:40::/48
ipset jump4 10.40.1.10
ipset jump6 2001:db8:40:1::10
ipset mon4 10.40.2.20
ipset mon6 2001:db8:40:2::20
ipset mbox4 10.40.3.30
ipset mbox6 2001:db8:40:3::30
ipset dns4 10.40.0.53,10.40.0.54
ipset dns6 2001:db8:40::53,2001:db8:40::54

*ip4
:INPUT DROP
:OUTPUT DROP
[in4-01] -A INPUT -i lo -j ACCEPT
[in4-02] -A INPUT --state INVALID -j DROP
[in4-03] -A INPUT --state ESTABLISHED,RELATED -j ACCEPT
[in4-04] -A INPUT -p tcp --dport 25 --state NEW --limit 20/sec -j ACCEPT
[in4-05] -A INPUT -p tcp -s @internal4 --dport 587 -j ACCEPT
[in4-06] -A INPUT -p tcp -s @jump4 --dport 22 -j ACCEPT
[in4-07] -A INPUT -p tcp -s @jump4 --dport 8443 -j ACCEPT
[in4-08] -A INPUT -p tcp -s @mon4 --dport 9100 -j ACCEPT
[in4-09] -A INPUT -p icmp --limit 10/sec -j ACCEPT
[out4-01] -A OUTPUT -o lo -j ACCEPT
[out4-02] -A OUTPUT --state INVALID -j DROP
[out4-09] -A OUTPUT --state ESTABLISHED,RELATED -j ACCEPT
[out4-03] -A OUTPUT -p tcp --dport 25 -j ACCEPT
[out4-05] -A OUTPUT -p udp -d @dns4 --dport 53 -j ACCEPT
[out4-06] -A OUTPUT -p tcp -d @dns4 --dport 53 -j ACCEPT
[out4-07] -A OUTPUT -p udp --dport 123 -j ACCEPT
[out4-08] -A OUTPUT -p tcp -d @mbox4 --dport 24 -j ACCEPT
COMMIT

*ip6
:INPUT DROP
:OUTPUT DROP
[in6-01] -A INPUT -i lo -j ACCEPT
[in6-02] -A INPUT --state INVALID -j DROP
[in6-03] -A INPUT --state ESTABLISHED,RELATED -j ACCEPT
[in6-04] -A INPUT -p tcp --dport 25 --state NEW --limit 20/sec -j ACCEPT
[in6-05] -A INPUT -p tcp -s @internal6 --dport 587 -j ACCEPT
[in6-06] -A INPUT -p tcp -s @jump6 --dport 22,8443 -j ACCEPT
[in6-07] -A INPUT -p tcp -s @mon6 --dport 9100 -j ACCEPT
[in6-08] -A INPUT -p ipv6-icmp --limit 10/sec -j ACCEPT
[out6-01] -A OUTPUT -o lo -j ACCEPT
[out6-02] -A OUTPUT --state INVALID -j DROP
[out6-03] -A OUTPUT --state ESTABLISHED,RELATED -j ACCEPT
[out6-04] -A OUTPUT -p tcp --dport 25 -j ACCEPT
[out6-05] -A OUTPUT -p udp -d @dns6 --dport 53 -j ACCEPT
[out6-06] -A OUTPUT -p tcp -d @dns6 --dport 53 -j ACCEPT
[out6-07] -A OUTPUT -p udp --dport 123 -j ACCEPT
[out6-08] -A OUTPUT -p tcp -d @mbox6 --dport 24 -j ACCEPT
COMMIT
